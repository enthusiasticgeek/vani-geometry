// vani-geometry  v0.1.0 — computational and analytic geometry library
//
// ENCODING: Point2D/Point3D/Plane are plain structs with only f64 fields --
// no heap-owning fields, so they are Copy (freely passable/reusable by
// value, no `ref`/`mut ref` ceremony needed for scalar arguments). Functions
// that take a *collection* of points use `ref Vec<Point2D>` (read-only) or
// `mut ref Vec<Point2D>` (in-place sort), matching the Vec<f64> convention
// established in vani-matrix/vani-optimize.
//
// IMPORTANT — do NOT reimplement vāṇी compiler builtins.
// Already available as builtins (call directly, never redeclare here):
//   abs sqrt sin cos tan atan2 acos asin f64_hypot f64_pi push pop len set
//
// v0.1.0 depends on nothing else in the Kosh ecosystem.

struct Point2D { x: f64, y: f64 }
struct Point3D { x: f64, y: f64, z: f64 }
struct Plane { nx: f64, ny: f64, nz: f64, d: f64 }

// ── 2D point/vector construction and arithmetic ──────────────────────────────

#[bounded_stack(bytes = 80)]
fn point2d_new(x: f64, y: f64) -> Point2D {
    return Point2D { x: x, y: y };
}

#[bounded_stack(bytes = 128)]
fn point2d_add(a: Point2D, b: Point2D) -> Point2D {
    return Point2D { x: a.x + b.x, y: a.y + b.y };
}

#[bounded_stack(bytes = 128)]
fn point2d_sub(a: Point2D, b: Point2D) -> Point2D {
    return Point2D { x: a.x - b.x, y: a.y - b.y };
}

#[bounded_stack(bytes = 104)]
fn point2d_scale(a: Point2D, s: f64) -> Point2D {
    return Point2D { x: a.x * s, y: a.y * s };
}

#[bounded_stack(bytes = 104)]
fn point2d_distance(a: Point2D, b: Point2D) -> f64 {
    return f64_hypot(a.x - b.x, a.y - b.y);
}

#[bounded_stack(bytes = 128)]
fn point2d_midpoint(a: Point2D, b: Point2D) -> Point2D {
    return Point2D { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 };
}

// ── 2D vector operations (a Point2D doubles as a 2D vector) ──────────────────

#[bounded_stack(bytes = 104)]
fn vec2d_dot(a: Point2D, b: Point2D) -> f64 {
    return a.x * b.x + a.y * b.y;
}

// Scalar (z-component) of the 3D cross product a × b, treating a, b as
// vectors in the xy-plane. Positive when b is counter-clockwise from a.
#[bounded_stack(bytes = 104)]
fn vec2d_cross(a: Point2D, b: Point2D) -> f64 {
    return a.x * b.y - a.y * b.x;
}

#[bounded_stack(bytes = 72)]
fn vec2d_norm(a: Point2D) -> f64 {
    return f64_hypot(a.x, a.y);
}

#[bounded_stack(bytes = 176)]
fn vec2d_normalize(a: Point2D) -> Point2D {
    let n: f64 = vec2d_norm(a);
    return Point2D { x: a.x / n, y: a.y / n };
}

// Angle in radians between two vectors, range [0, pi], via atan2(|cross|, dot)
// (numerically safer near 0 and pi than acos(dot/(|a||b|))).
#[bounded_stack(bytes = 208)]
fn vec2d_angle_between(a: Point2D, b: Point2D) -> f64 {
    return atan2(abs(vec2d_cross(a, b)), vec2d_dot(a, b));
}

// ── 3D point/vector construction and arithmetic ──────────────────────────────

#[bounded_stack(bytes = 88)]
fn point3d_new(x: f64, y: f64, z: f64) -> Point3D {
    return Point3D { x: x, y: y, z: z };
}

#[bounded_stack(bytes = 128)]
fn point3d_add(a: Point3D, b: Point3D) -> Point3D {
    return Point3D { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z };
}

#[bounded_stack(bytes = 128)]
fn point3d_sub(a: Point3D, b: Point3D) -> Point3D {
    return Point3D { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z };
}

#[bounded_stack(bytes = 104)]
fn point3d_scale(a: Point3D, s: f64) -> Point3D {
    return Point3D { x: a.x * s, y: a.y * s, z: a.z * s };
}

#[bounded_stack(bytes = 128)]
fn point3d_distance(a: Point3D, b: Point3D) -> f64 {
    let dx: f64 = a.x - b.x;
    let dy: f64 = a.y - b.y;
    let dz: f64 = a.z - b.z;
    return sqrt(dx * dx + dy * dy + dz * dz);
}

#[bounded_stack(bytes = 104)]
fn vec3d_dot(a: Point3D, b: Point3D) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

#[bounded_stack(bytes = 128)]
fn vec3d_cross(a: Point3D, b: Point3D) -> Point3D {
    return Point3D {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x,
    };
}

#[bounded_stack(bytes = 72)]
fn vec3d_norm(a: Point3D) -> f64 {
    return sqrt(a.x * a.x + a.y * a.y + a.z * a.z);
}

#[bounded_stack(bytes = 176)]
fn vec3d_normalize(a: Point3D) -> Point3D {
    let n: f64 = vec3d_norm(a);
    return Point3D { x: a.x / n, y: a.y / n, z: a.z / n };
}

// ── 2D lines and segments ─────────────────────────────────────────────────────

// Perpendicular distance from point p to the infinite line through p1, p2.
#[bounded_stack(bytes = 328)]
fn line2d_point_distance(p1: Point2D, p2: Point2D, p: Point2D) -> f64 {
    let d: Point2D = point2d_sub(p2, p1);
    let v: Point2D = point2d_sub(p, p1);
    return abs(vec2d_cross(d, v)) / vec2d_norm(d);
}

// Distance from point p to the segment p1-p2 (clamped projection -- the
// nearest point may be an endpoint rather than the perpendicular foot).
#[bounded_stack(bytes = 360)]
fn segment_point_distance(p1: Point2D, p2: Point2D, p: Point2D) -> f64 {
    let d: Point2D = point2d_sub(p2, p1);
    let len_sq: f64 = vec2d_dot(d, d);
    if len_sq < 1.0e-18 {
        return point2d_distance(p1, p);
    }
    let t: f64 = vec2d_dot(point2d_sub(p, p1), d) / len_sq;
    let tc: f64 = f64_clamp(t, 0.0, 1.0);
    let proj: Point2D = point2d_add(p1, point2d_scale(d, tc));
    return point2d_distance(p, proj);
}

// Whether segments p1-p2 and p3-p4 intersect (including touching at an
// endpoint), via the standard orientation test.
#[bounded_stack(bytes = 386)]
fn segments_intersect(p1: Point2D, p2: Point2D, p3: Point2D, p4: Point2D) -> bool {
    let d1: Point2D = point2d_sub(p2, p1);
    let d2: Point2D = point2d_sub(p4, p3);
    let o1: f64 = vec2d_cross(d1, point2d_sub(p3, p1));
    let o2: f64 = vec2d_cross(d1, point2d_sub(p4, p1));
    let o3: f64 = vec2d_cross(d2, point2d_sub(p1, p3));
    let o4: f64 = vec2d_cross(d2, point2d_sub(p2, p3));
    if ((o1 > 0.0 && o2 < 0.0) || (o1 < 0.0 && o2 > 0.0))
        && ((o3 > 0.0 && o4 < 0.0) || (o3 < 0.0 && o4 > 0.0)) {
        return true;
    }
    return false;
}

// Intersection point of the infinite lines through p1-p2 and p3-p4.
// Undefined (division by ~0) when the lines are parallel -- check with
// segments_intersect (or compare directions) first if that's possible.
#[bounded_stack(bytes = 296)]
fn segment_intersection_point(p1: Point2D, p2: Point2D, p3: Point2D, p4: Point2D) -> Point2D {
    let x1: f64 = p1.x; let y1: f64 = p1.y;
    let x2: f64 = p2.x; let y2: f64 = p2.y;
    let x3: f64 = p3.x; let y3: f64 = p3.y;
    let x4: f64 = p4.x; let y4: f64 = p4.y;
    let denom: f64 = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
    let a: f64 = x1 * y2 - y1 * x2;
    let b: f64 = x3 * y4 - y3 * x4;
    let px: f64 = (a * (x3 - x4) - (x1 - x2) * b) / denom;
    let py: f64 = (a * (y3 - y4) - (y1 - y2) * b) / denom;
    return Point2D { x: px, y: py };
}

// ── Triangles and polygons ────────────────────────────────────────────────────

#[bounded_stack(bytes = 264)]
fn triangle_area(p1: Point2D, p2: Point2D, p3: Point2D) -> f64 {
    return abs(vec2d_cross(point2d_sub(p2, p1), point2d_sub(p3, p1))) / 2.0;
}

// Polygon area via the shoelace formula. `pts` should be a simple polygon's
// vertices in order (either winding); the result is always non-negative.
#[bounded_stack(bytes = 128)]
fn polygon_area(pts: ref Vec<Point2D>, n: i64) -> f64 {
    let s: f64 = 0.0;
    let i: i64 = 0;
    while i < n {
        let j: i64 = (i + 1) % n;
        s = s + pts[i].x * pts[j].y - pts[j].x * pts[i].y;
        i = i + 1;
    }
    return abs(s) / 2.0;
}

#[bounded_stack(bytes = 200)]
fn polygon_perimeter(pts: ref Vec<Point2D>, n: i64) -> f64 {
    let s: f64 = 0.0;
    let i: i64 = 0;
    while i < n {
        let j: i64 = (i + 1) % n;
        s = s + point2d_distance(pts[i], pts[j]);
        i = i + 1;
    }
    return s;
}

// Centroid of a simple polygon (area-weighted, not the mean of vertices --
// the two differ for non-regular polygons).
#[bounded_stack(bytes = 168)]
fn polygon_centroid(pts: ref Vec<Point2D>, n: i64) -> Point2D {
    let a: f64 = 0.0;
    let cx: f64 = 0.0;
    let cy: f64 = 0.0;
    let i: i64 = 0;
    while i < n {
        let j: i64 = (i + 1) % n;
        let cross: f64 = pts[i].x * pts[j].y - pts[j].x * pts[i].y;
        a = a + cross;
        cx = cx + (pts[i].x + pts[j].x) * cross;
        cy = cy + (pts[i].y + pts[j].y) * cross;
        i = i + 1;
    }
    a = a * 0.5;
    return Point2D { x: cx / (6.0 * a), y: cy / (6.0 * a) };
}

// Ray-casting point-in-polygon test. Boundary behavior is unspecified (as
// usual for this algorithm) -- points exactly on an edge may return either
// true or false depending on floating-point rounding.
#[bounded_stack(bytes = 152)]
fn point_in_polygon(pts: ref Vec<Point2D>, n: i64, p: Point2D) -> bool {
    let inside: bool = false;
    let i: i64 = 0;
    let j: i64 = n - 1;
    while i < n {
        let xi: f64 = pts[i].x; let yi: f64 = pts[i].y;
        let xj: f64 = pts[j].x; let yj: f64 = pts[j].y;
        if ((yi > p.y) != (yj > p.y)) && (p.x < (xj - xi) * (p.y - yi) / (yj - yi) + xi) {
            inside = !inside;
        }
        j = i;
        i = i + 1;
    }
    return inside;
}

// Brute-force closest pair of points, O(n^2). Fine for the modest input
// sizes this library targets; a divide-and-conquer O(n log n) version is a
// candidate for a future version if a real need for large n shows up.
#[bounded_stack(bytes = 216)]
fn closest_pair_distance(pts: ref Vec<Point2D>, n: i64) -> f64 {
    let best: f64 = f64_max_finite();
    let i: i64 = 0;
    while i < n {
        let j: i64 = i + 1;
        while j < n {
            let d: f64 = point2d_distance(pts[i], pts[j]);
            if d < best { best = d; }
            j = j + 1;
        }
        i = i + 1;
    }
    return best;
}

// In-place insertion sort of `pts` by (x, then y) lexicographic order.
// A manual sort rather than the builtin `sort`/`sort_by` (numeric-Vec-only
// as of vani-compiler MATH-2) -- O(n^2), fine for convex_hull's typical
// input sizes.
#[bounded_stack(bytes = 128)]
fn _sort_points_lex(pts: mut ref Vec<Point2D>, n: i64) {
    let i: i64 = 1;
    while i < n {
        let key: Point2D = pts[i];
        let j: i64 = i - 1;
        while j >= 0 && (pts[j].x > key.x || (pts[j].x == key.x && pts[j].y > key.y)) {
            set(pts, j + 1, pts[j]);
            j = j - 1;
        }
        set(pts, j + 1, key);
        i = i + 1;
    }
}

// Convex hull via Andrew's monotone chain, O(n log n) dominated by the sort
// step here being O(n^2) (see _sort_points_lex) -- still far cheaper than
// the O(n^3) gift-wrapping alternative for anything but tiny n. Returns
// hull vertices in counter-clockwise order, no repeated closing point.
// Assumes `pts` has no duplicate points and at least 3 are not collinear;
// degenerate inputs (all collinear, or fewer than 3 points) return a
// meaningless result rather than erroring, matching v0.1.0's scope.
#[bounded_stack(bytes = 648)]
fn convex_hull(pts: ref Vec<Point2D>, n: i64) -> Vec<Point2D> {
    let sorted: Vec<Point2D> = vec();
    let k0: i64 = 0;
    while k0 < n {
        push(mut ref sorted, pts[k0]);
        k0 = k0 + 1;
    }
    _sort_points_lex(mut ref sorted, n);

    let lower: Vec<Point2D> = vec();
    let i: i64 = 0;
    while i < n {
        while (len(ref lower) as i64) >= 2 {
            let a: Point2D = lower[(len(ref lower) as i64) - 2];
            let b: Point2D = lower[(len(ref lower) as i64) - 1];
            if vec2d_cross(point2d_sub(b, a), point2d_sub(sorted[i], a)) <= 0.0 {
                let _drop: Point2D = pop(mut ref lower);
            } else {
                break;
            }
        }
        push(mut ref lower, sorted[i]);
        i = i + 1;
    }

    let upper: Vec<Point2D> = vec();
    let ii: i64 = n - 1;
    while ii >= 0 {
        while (len(ref upper) as i64) >= 2 {
            let a: Point2D = upper[(len(ref upper) as i64) - 2];
            let b: Point2D = upper[(len(ref upper) as i64) - 1];
            if vec2d_cross(point2d_sub(b, a), point2d_sub(sorted[ii], a)) <= 0.0 {
                let _drop: Point2D = pop(mut ref upper);
            } else {
                break;
            }
        }
        push(mut ref upper, sorted[ii]);
        ii = ii - 1;
    }

    let _last_lower: Point2D = pop(mut ref lower);
    let _last_upper: Point2D = pop(mut ref upper);
    let hull: Vec<Point2D> = vec();
    let hi: i64 = 0;
    let lower_n: i64 = len(ref lower) as i64;
    while hi < lower_n {
        push(mut ref hull, lower[hi]);
        hi = hi + 1;
    }
    let hj: i64 = 0;
    let upper_n: i64 = len(ref upper) as i64;
    while hj < upper_n {
        push(mut ref hull, upper[hj]);
        hj = hj + 1;
    }
    return hull;
}

// ── Circles ────────────────────────────────────────────────────────────────────

// Circumcenter of the triangle p1, p2, p3 (the point equidistant from all
// three). Undefined (division by ~0) for collinear points.
#[bounded_stack(bytes = 256)]
fn circumcenter(p1: Point2D, p2: Point2D, p3: Point2D) -> Point2D {
    let ax: f64 = p1.x; let ay: f64 = p1.y;
    let bx: f64 = p2.x; let by: f64 = p2.y;
    let cx: f64 = p3.x; let cy: f64 = p3.y;
    let d: f64 = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));
    let a2: f64 = ax * ax + ay * ay;
    let b2: f64 = bx * bx + by * by;
    let c2: f64 = cx * cx + cy * cy;
    let ux: f64 = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d;
    let uy: f64 = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d;
    return Point2D { x: ux, y: uy };
}

#[bounded_stack(bytes = 392)]
fn circumradius(p1: Point2D, p2: Point2D, p3: Point2D) -> f64 {
    return point2d_distance(circumcenter(p1, p2, p3), p1);
}

// ── Conic sections ───────────────────────────────────────────────────────────

// Classifies the general conic A x^2 + B xy + C y^2 + ... = 0 by its
// discriminant B^2 - 4AC: 0 = ellipse (circle is the special case B=0, A=C),
// 1 = parabola, 2 = hyperbola. Degenerate conics (discriminant exactly 0 but
// not a genuine parabola, e.g. two parallel lines) aren't distinguished from
// true parabolas in v0.1.0.
#[bounded_stack(bytes = 88)]
fn conic_classify(coeff_a: f64, coeff_b: f64, coeff_c: f64) -> i64 {
    let disc: f64 = coeff_b * coeff_b - 4.0 * coeff_a * coeff_c;
    if disc < 0.0 { return 0; }
    if disc == 0.0 { return 1; }
    return 2;
}

// ── 3D planes and lines ──────────────────────────────────────────────────────

// Plane through three non-collinear points, as normal (nx,ny,nz) and offset
// d in the equation nx*x + ny*y + nz*z + d = 0. The normal is not
// normalized (its length is |cross product|, not 1) -- point_plane_distance
// divides by the normal's length itself, so this is safe to pass directly.
#[bounded_stack(bytes = 392)]
fn plane_from_points(p1: Point3D, p2: Point3D, p3: Point3D) -> Plane {
    let u: Point3D = point3d_sub(p2, p1);
    let v: Point3D = point3d_sub(p3, p1);
    let n: Point3D = vec3d_cross(u, v);
    let d: f64 = 0.0 - vec3d_dot(n, p1);
    return Plane { nx: n.x, ny: n.y, nz: n.z, d: d };
}

#[bounded_stack(bytes = 120)]
fn point_plane_distance(pl: Plane, p: Point3D) -> f64 {
    let num: f64 = pl.nx * p.x + pl.ny * p.y + pl.nz * p.z + pl.d;
    let denom: f64 = sqrt(pl.nx * pl.nx + pl.ny * pl.ny + pl.nz * pl.nz);
    return abs(num) / denom;
}

// Shortest distance between two (possibly skew) lines, each given as a point
// and a direction vector. Falls back to point-to-line distance if the
// directions are parallel (cross product ~0), rather than dividing by ~0.
#[bounded_stack(bytes = 416)]
fn line3d_distance(p1: Point3D, d1: Point3D, p2: Point3D, d2: Point3D) -> f64 {
    let n: Point3D = vec3d_cross(d1, d2);
    let n_norm: f64 = vec3d_norm(n);
    if n_norm < 1.0e-12 {
        let w: Point3D = point3d_sub(p2, p1);
        let t: f64 = vec3d_dot(w, d1) / vec3d_dot(d1, d1);
        let closest: Point3D = point3d_add(p1, point3d_scale(d1, t));
        return point3d_distance(p2, closest);
    }
    return abs(vec3d_dot(point3d_sub(p2, p1), n)) / n_norm;
}

// ── Triangle angles ──────────────────────────────────────────────────────────

// Angle opposite side c in a triangle with side lengths a, b, c (law of
// cosines), in radians. Requires a valid triangle (each side shorter than
// the sum of the other two); no validation is performed in v0.1.0.
#[bounded_stack(bytes = 64)]
fn triangle_angle(a: f64, b: f64, c: f64) -> f64 {
    return acos((a * a + b * b - c * c) / (2.0 * a * b));
}
