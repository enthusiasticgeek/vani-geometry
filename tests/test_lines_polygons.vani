// Tests for 2D lines, segments, triangles, polygons, convex hull, and
// closest-pair.
// Run with:  vanic test tests/test_lines_polygons.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

fn main() -> i64 {
    // Distance from (0,5) to the x-axis (line through (0,0)-(1,0)) is 5.
    let o: Point2D = point2d_new(0.0, 0.0);
    let e1: Point2D = point2d_new(1.0, 0.0);
    let p_above: Point2D = point2d_new(0.0, 5.0);
    assert close(line2d_point_distance(o, e1, p_above), 5.0);

    // Distance to a *segment* (0,0)-(1,0) from (2,3): nearest point is the
    // endpoint (1,0), not the perpendicular foot -- distance = hypot(1,3).
    let far_pt: Point2D = point2d_new(2.0, 3.0);
    assert close(segment_point_distance(o, e1, far_pt), f64_hypot(1.0, 3.0));
    // A point directly above the segment's interior: distance = perpendicular.
    let mid_above: Point2D = point2d_new(0.5, 2.0);
    assert close(segment_point_distance(o, e1, mid_above), 2.0);

    // Crossing diagonals of a unit square intersect.
    let p1: Point2D = point2d_new(0.0, 0.0);
    let p2: Point2D = point2d_new(2.0, 2.0);
    let p3: Point2D = point2d_new(0.0, 2.0);
    let p4: Point2D = point2d_new(2.0, 0.0);
    assert segments_intersect(p1, p2, p3, p4);
    let ip: Point2D = segment_intersection_point(p1, p2, p3, p4);
    assert close(ip.x, 1.0);
    assert close(ip.y, 1.0);

    // Parallel, non-intersecting segments.
    let q1: Point2D = point2d_new(0.0, 0.0);
    let q2: Point2D = point2d_new(1.0, 0.0);
    let q3: Point2D = point2d_new(0.0, 1.0);
    let q4: Point2D = point2d_new(1.0, 1.0);
    assert !segments_intersect(q1, q2, q3, q4);

    // Triangle area: right triangle legs 4 and 3 -> area 6.
    assert close(triangle_area(point2d_new(0.0,0.0), point2d_new(4.0,0.0), point2d_new(0.0,3.0)), 6.0);

    // Unit square: area 1, perimeter 4, centroid (0.5,0.5).
    let square: Vec<Point2D> = vec(point2d_new(0.0, 0.0));
    push(mut ref square, point2d_new(1.0, 0.0));
    push(mut ref square, point2d_new(1.0, 1.0));
    push(mut ref square, point2d_new(0.0, 1.0));
    assert close(polygon_area(ref square, 4), 1.0);
    assert close(polygon_perimeter(ref square, 4), 4.0);
    let cen: Point2D = polygon_centroid(ref square, 4);
    assert close(cen.x, 0.5);
    assert close(cen.y, 0.5);
    assert point_in_polygon(ref square, 4, point2d_new(0.5, 0.5));
    assert !point_in_polygon(ref square, 4, point2d_new(2.0, 2.0));

    // A 3-4-5 right triangle has area 6 via the shoelace formula too.
    let tri: Vec<Point2D> = vec(point2d_new(0.0, 0.0));
    push(mut ref tri, point2d_new(4.0, 0.0));
    push(mut ref tri, point2d_new(0.0, 3.0));
    assert close(polygon_area(ref tri, 3), 6.0);

    // Convex hull of a square plus one interior point excludes the interior
    // point -- hull has exactly 4 vertices, not 5.
    let hullpts: Vec<Point2D> = vec(point2d_new(0.0, 0.0));
    push(mut ref hullpts, point2d_new(2.0, 0.0));
    push(mut ref hullpts, point2d_new(2.0, 2.0));
    push(mut ref hullpts, point2d_new(0.0, 2.0));
    push(mut ref hullpts, point2d_new(1.0, 1.0));
    let hull: Vec<Point2D> = convex_hull(ref hullpts, 5);
    assert (len(ref hull) as i64) == 4;
    // Every hull vertex must be one of the 4 square corners (not the
    // interior point (1,1)).
    let hn: i64 = len(ref hull) as i64;
    let k: i64 = 0;
    while k < hn {
        assert !(close(hull[k].x, 1.0) && close(hull[k].y, 1.0));
        k = k + 1;
    }
    // The hull's area should equal the full square's area (4x4... here 2x2 = 4).
    assert close(polygon_area(ref hull, hn), 4.0);

    // Closest pair: two points at distance 0.2 are closer than any other
    // pair in the set.
    let cppts: Vec<Point2D> = vec(point2d_new(0.0, 0.0));
    push(mut ref cppts, point2d_new(3.0, 4.0));
    push(mut ref cppts, point2d_new(1.0, 1.0));
    push(mut ref cppts, point2d_new(1.0, 1.2));
    assert close(closest_pair_distance(ref cppts, 4), 0.2);

    return 0;
}
